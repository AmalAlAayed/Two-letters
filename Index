        await setDoc(getRoomRef(code), initialRoom);
        state.mode = 'online';
        state.roomCode = code;
        state.myTeam = 'team1';
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('room', code);
          window.history.replaceState({}, '', url.toString());
        } catch (e) {}
        listenToRoom(code);
        showToast(`تم إنشاء الغرفة بنجاح! الرمز: ${code}`, 'success');
      } catch (err) {
        console.error(err);
        showToast('حدث خطأ أثناء إنشاء الغرفة. جرب وضع اللعب السريع.', 'error');
      }
    }

    async function joinOnlineRoom(codeInput) {
      if (!db || !currentUser) {
        showToast('لم يتم الاتصال بالخادم بعد. تأكد من إعدادات Firebase.', 'warn');
        return;
      }
      const code = (codeInput || document.getElementById('join-room-code').value).trim().toUpperCase();
      const teamName = document.getElementById('join-team-name').value.trim() || 'الفريق الثاني';
      if (!code || code.length < 4) {
        showToast('يرجى إدخال رمز الغرفة الصحيح.', 'error');
        return;
      }
      try {
        const snap = await getDoc(getRoomRef(code));
        if (!snap.exists()) {
          showToast('لم يتم العثور على غرفة بهذا الرمز!', 'error');
          return;
        }
        const data = snap.data();
        state.mode = 'online';
        state.roomCode = code;
        if (data.team1 && data.team1.uid === currentUser.uid) {
          state.myTeam = 'team1';
        } else if (data.team2 && data.team2.uid === currentUser.uid) {
          state.myTeam = 'team2';
        } else if (!data.team2) {
          state.myTeam = 'team2';
          await updateDoc(getRoomRef(code), {
            team2: {
              uid: currentUser.uid,
              name: teamName,
              score: 0,
              solvedCount: 0,
              finishTime: null
            }
          });
        } else {
          showToast('عذراً، الغرفة مكتملة بفريقين بالفعل!', 'error');
          return;
        }
        listenToRoom(code);
        showToast('تم الانضمام إلى الغرفة بنجاح!', 'success');
      } catch (err) {
        console.error(err);
        showToast('تعذر الانضمام للغرفة.', 'error');
      }
    }

    function listenToRoom(code) {
      if (state.unsubscribeRoom) state.unsubscribeRoom();
      state.unsubscribeRoom = onSnapshot(
        getRoomRef(code),
        (snapshot) => {
          if (!snapshot.exists()) return;
          const prevData = state.roomData;
          const data = snapshot.data();
          state.roomData = data;
          syncUIWithOnlineRoom(data, prevData);
        },
        (error) => {
          console.error('Room listener error:', error);
          showToast('انقطع الاتصال المباشر بالغرفة.', 'error');
        }
      );
    }

    function syncUIWithOnlineRoom(data, prevData) {
      const t1Name = data.team1?.name || 'الفريق الأول';
      const t2Name = data.team2?.name || 'بانتظار الفريق الثاني...';
      document.getElementById('lobby-t1-name').textContent = t1Name;
      document.getElementById('lobby-t1-score').textContent = data.team1?.score || 0;
      document.getElementById('lobby-t2-name').textContent = t2Name;
      document.getElementById('lobby-t2-score').textContent = data.team2?.score || 0;
      document.getElementById('display-room-code').textContent = data.code;
      document.getElementById('room-share-box').classList.remove('hidden');

      const banner = document.getElementById('lobby-status-banner');
      if (!data.team2) {
        banner.textContent = '⏳ في انتظار دخول الفريق الثاني... شاركوا رابط الدعوة أو رمز الغرفة أعلاه!';
        banner.className = 'mt-4 p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-sm font-bold text-center';
      } else {
        banner.textContent = `✅ الفريقان جاهزان (${t1Name} ضد ${t2Name})! اختاروا الحرفين لبدء السباق فوراً!`;
        banner.className = 'mt-4 p-3.5 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-sm font-bold text-center';
      }

      if (data.status === 'playing' && state.currentGroup) {
        const totalQ = state.currentGroup.items.length;
        const t1Solved = data.team1?.solvedCount || 0;
        const t2Solved = data.team2?.solvedCount || 0;
        document.getElementById('game-t1-name').textContent = t1Name;
        document.getElementById('game-t1-count').textContent = `${t1Solved} / ${totalQ}`;
        document.getElementById('game-t1-bar').style.width = `${(t1Solved / totalQ) * 100}%`;
        document.getElementById('game-t2-name').textContent = t2Name;
        document.getElementById('game-t2-count').textContent = `${t2Solved} / ${totalQ}`;
        document.getElementById('game-t2-bar').style.width = `${(t2Solved / totalQ) * 100}%`;
      }

      if (data.status === 'lobby') {
        stopRoundTimer();
        renderLettersGrid(data.usedGroups || [], true);
        switchScreen('screen-lobby');
      } else if (data.status === 'playing') {
        const isNewRound = !prevData || prevData.status !== 'playing' || prevData.activeGroupId !== data.activeGroupId;
        if (isNewRound && data.activeGroupId) startRoundSequence(data.activeGroupId);
      } else if (data.status === 'finished') {
        stopRoundTimer();
        renderOnlineResults(data);
      }
    }

    // ==========================================
‎    // 9. اختيار الحرفين وبدء الجولة
    // ==========================================
    async function handleSelectGroup(groupId) {
      if (state.mode === 'online') {
        if (!state.roomData?.team2) {
          showToast('انتظر دخول الفريق الثاني أولاً أو شاركه رابط الغرفة!', 'warn');
          return;
        }
        try {
          const used = Array.from(new Set([...(state.roomData.usedGroups || []), groupId]));
          await updateDoc(getRoomRef(state.roomCode), {
            status: 'playing',
            activeGroupId: groupId,
            roundStartTimestamp: Date.now(),
            usedGroups: used,
            roundWinner: null,
            'team1.solvedCount': 0,
            'team1.finishTime': null,
            'team2.solvedCount': 0,
            'team2.finishTime': null
          });
        } catch (err) {
          console.error(err);
          showToast('حدث خطأ في بدء الجولة.', 'error');
        }
      } else {
        state.localData.activeGroupId = groupId;
        state.localData.currentTurn = 'team1';
        state.localData.team1Time = 0;
        state.localData.team1Solved = 0;
        state.localData.team2Time = 0;
        state.localData.team2Solved = 0;
        if (!state.localData.usedGroups.includes(groupId)) state.localData.usedGroups.push(groupId);
        startRoundSequence(groupId);
      }
    }

    function startRoundSequence(groupId) {
      const group = QUIZ_GROUPS.find(g => g.id === groupId);
      if (!group) return;
      state.currentGroup = group;
      state.solvedIndices = new Set();
      state.hintsUsed = new Set();
      state.penaltySeconds = 0;
      state.isRoundActive = false;
      stopRoundTimer();

      const cdScreen = document.getElementById('screen-countdown');
      const cdNum = document.getElementById('countdown-number');
      const cdLetters = document.getElementById('countdown-letters');
      const cdLabel = document.getElementById('countdown-team-label');

      cdLetters.textContent = group.display;
      if (state.mode === 'local') {
        const turnName = state.localData.currentTurn === 'team1' ? state.localData.team1Name : state.localData.team2Name;
        cdLabel.textContent = `دور: ${turnName} (يمنع نظر الفريق المنافس!)`;
      } else {
        const myName = state.myTeam === 'team1' ? state.roomData?.team1?.name : state.roomData?.team2?.name;
        cdLabel.textContent = `استعدوا يا ${myName || 'أبطال'}!`;
      }

      cdScreen.classList.remove('hidden');
      let count = 3;
      cdNum.textContent = count;
      playSound('tick');

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          cdNum.textContent = count;
          playSound('tick');
        } else if (count === 0) {
          cdNum.textContent = 'انطلق!';
          playSound('go');
        } else {
          clearInterval(interval);
          cdScreen.classList.add('hidden');
          beginActiveGameplay();
        }
      }, 650);
    }

    // ==========================================
‎    // 10. شاشة التحدي والتحقق
    // ==========================================
    function beginActiveGameplay() {
      switchScreen('screen-game');
      state.isRoundActive = true;
      state.roundStartTime = Date.now();
      const group = state.currentGroup;
      document.getElementById('game-active-letters').textContent = group.display;

      if (state.mode === 'local') {
        const isT1 = state.localData.currentTurn === 'team1';
        const activeName = isT1 ? state.localData.team1Name : state.localData.team2Name;
        const badge = document.getElementById('current-turn-badge');
        badge.textContent = isT1 ? 'الدور الأول' : 'الدور الثاني (الحسم)';
        badge.className = `inline-block px-2.5 py-0.5 rounded-md text-xs font-bold mb-0.5 ${
          isT1 ? 'bg-sky-500/20 text-sky-300' : 'bg-orange-500/20 text-orange-300'
        }`;
        document.getElementById('game-prompt-title').textContent = `دور ${activeName} — أجب بأسرع وقت!`;
        document.getElementById('game-t1-name').textContent = state.localData.team1Name;
        document.getElementById('game-t2-name').textContent = state.localData.team2Name;
        document.getElementById('game-t1-count').textContent = `${state.localData.team1Solved} / ${group.items.length}`;
        document.getElementById('game-t2-count').textContent = `${state.localData.team2Solved} / ${group.items.length}`;
        document.getElementById('game-t1-bar').style.width = `${(state.localData.team1Solved / group.items.length) * 100}%`;
        document.getElementById('game-t2-bar').style.width = `${(state.localData.team2Solved / group.items.length) * 100}%`;
      } else {
        const myName = state.myTeam === 'team1' ? state.roomData?.team1?.name : state.roomData?.team2?.name;
        document.getElementById('current-turn-badge').textContent = 'سباق مباشر 🔥';
        document.getElementById('game-prompt-title').textContent = `فريقك: ${myName} — اسبق المنافس!`;
      }

      const listEl = document.getElementById('questions-list');
      listEl.innerHTML = '';

      group.items.forEach((item, index) => {
        const row = document.createElement('div');
        row.id = `q-row-${index}`;
        row.className = 'glass-panel rounded-2xl p-4 border border-slate-700/80 transition-all duration-300 flex flex-col sm:flex-row sm:items-center justify-between gap-3';
        row.innerHTML = `
          <div class="flex items-start sm:items-center gap-3 flex-1">
            <span id="q-num-${index}" class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-600 flex items-center justify-center text-sm font-black text-slate-300 shrink-0">${index + 1}</span>
            <div>
              <p class="text-base sm:text-lg font-bold text-white leading-snug">${item.q}</p>
              <span id="q-hint-text-${index}" class="hidden text-xs text-amber-300 font-bold mt-1 block"></span>
            </div>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-56">
              <input type="text" id="q-input-${index}" data-index="${index}" autocomplete="off" autocorrect="off" spellcheck="false" placeholder="ينتهي بـ (${group.suffix})..." class="w-full pl-12 pr-3.5 py-2.5 rounded-xl bg-slate-900/90 border-2 border-slate-600 text-white font-bold text-base focus:outline-none focus:border-sky-400 transition" />
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-black text-amber-400/80 pointer-events-none select-none">ـ${group.suffix}</span>
            </div>
            <button type="button" id="q-hint-btn-${index}" title="كشف أول حرف (+5 ثوانٍ)" class="px-3 py-2.5 rounded-xl bg-slate-800 hover:bg-amber-950/60 border border-slate-600 hover:border-amber-500/50 text-amber-300 text-xs font-bold shrink-0 transition">💡 تلميح</button>
            <button type="button" id="q-skip-btn-${index}" title="تخطي السؤال (+10 ثوانٍ)" class="px-3 py-2.5 rounded-xl bg-slate-800 hover:bg-rose-950/60 border border-slate-600 hover:border-rose-500/50 text-rose-300 text-xs font-bold shrink-0 transition">⏭️ تخطي</button>
          </div>
        `;
        listEl.appendChild(row);

        document.getElementById(`q-input-${index}`).addEventListener('input', (e) => handleAnswerInput(index, e.target.value));
        document.getElementById(`q-hint-btn-${index}`).addEventListener('click', () => handleUseHint(index));
        document.getElementById(`q-skip-btn-${index}`).addEventListener('click', () => handleSkipQuestion(index));
      });

      setTimeout(() => {
        const firstInput = document.getElementById('q-input-0');
        if (firstInput) firstInput.focus();
      }, 100);

      startRoundTimer();
    }

    function startRoundTimer() {
      stopRoundTimer();
      const timerEl = document.getElementById('game-timer');
      timerEl.textContent = '00:00';
      state.timerInterval = setInterval(() => {
        if (!state.isRoundActive) return;
        const elapsed = Math.floor((Date.now() - state.roundStartTime) / 1000) + state.penaltySeconds;
        timerEl.textContent = formatTime(elapsed);
      }, 250);
    }

    function stopRoundTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
    }

    function handleUseHint(index) {
      if (!state.isRoundActive || state.solvedIndices.has(index) || state.hintsUsed.has(index)) return;
      state.hintsUsed.add(index);
      state.penaltySeconds += 5;
      playSound('hint');
      const primaryAns = state.currentGroup.items[index].a[0];
      const firstChar = primaryAns.charAt(0);
      const length = primaryAns.length;
      const hintText = document.getElementById(`q-hint-text-${index}`);
      hintText.textContent = `تلميح: تبدأ بحرف «${firstChar}» وتتكون من ${length} أحرف (+5 ثوانٍ)`;
      hintText.classList.remove('hidden');
      const hintBtn = document.getElementById(`q-hint-btn-${index}`);
      hintBtn.disabled = true;
      hintBtn.classList.add('opacity-40', 'cursor-not-allowed');
      document.getElementById(`q-input-${index}`).focus();
    }

    async function handleSkipQuestion(index) {
      if (!state.isRoundActive || state.solvedIndices.has(index)) return;
      state.penaltySeconds += 10;
      playSound('hint');
      showToast('تم تخطي السؤال (+10 ثوانٍ عقوبة زمنية)', 'warn');
      await markQuestionResolved(index, true);
    }

    async function handleAnswerInput(index, value) {
      if (!state.isRoundActive || state.solvedIndices.has(index)) return;
      const item = state.currentGroup.items[index];
      if (!checkAnswerMatch(value, item.a)) return;
      playSound('correct');
      await markQuestionResolved(index, false);
    }

    async function markQuestionResolved(index, wasSkipped) {
      state.solvedIndices.add(index);
      const item = state.currentGroup.items[index];
      const row = document.getElementById(`q-row-${index}`);
      const numBadge = document.getElementById(`q-num-${index}`);
      const inputEl = document.getElementById(`q-input-${index}`);
      const hintBtn = document.getElementById(`q-hint-btn-${index}`);
      const skipBtn = document.getElementById(`q-skip-btn-${index}`);

      row.classList.remove('border-slate-700/80');
      if (wasSkipped) {
        row.classList.add('border-amber-500/70', 'bg-amber-950/20');
        numBadge.className = 'w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center text-sm font-black shrink-0';
        numBadge.textContent = '⏭';
        inputEl.classList.remove('border-slate-600', 'focus:border-sky-400');
        inputEl.classList.add('border-amber-500/70', 'bg-amber-950/40', 'text-amber-300');
      } else {
        row.classList.add('border-emerald-500', 'bg-emerald-950/30', 'solved-row');
        numBadge.className = 'w-8 h-8 rounded-xl bg-emerald-500 text-slate-950 flex items-center justify-center text-sm font-black shrink-0';
        numBadge.textContent = '✓';
        inputEl.classList.remove('border-slate-600', 'focus:border-sky-400');
        inputEl.classList.add('border-emerald-500', 'bg-emerald-950/60', 'text-emerald-300');
      }
      inputEl.value = item.a[0];
      inputEl.disabled = true;
      if (hintBtn) hintBtn.classList.add('hidden');
      if (skipBtn) skipBtn.classList.add('hidden');

      const totalQ = state.currentGroup.items.length;
      const solvedCount = state.solvedIndices.size;

      if (state.mode === 'online') {
        const myField = state.myTeam;
        const pct = (solvedCount / totalQ) * 100;
        if (myField === 'team1') {
          document.getElementById('game-t1-count').textContent = `${solvedCount} / ${totalQ}`;
          document.getElementById('game-t1-bar').style.width = `${pct}%`;
        } else {
          document.getElementById('game-t2-count').textContent = `${solvedCount} / ${totalQ}`;
          document.getElementById('game-t2-bar').style.width = `${pct}%`;
        }
        const elapsed = Number(((Date.now() - state.roundStartTime) / 1000 + state.penaltySeconds).toFixed(1));
        if (solvedCount === totalQ) {
          state.isRoundActive = false;
          stopRoundTimer();
          const currentScore = state.roomData?.[myField]?.score || 0;
          const updates = {
            [`${myField}.solvedCount`]: solvedCount,
            [`${myField}.finishTime`]: elapsed
          };
          if (!state.roomData?.roundWinner) {
            updates.status = 'finished';
            updates.roundWinner = myField;
            updates[`${myField}.score`] = currentScore + 1;
          }
          await updateDoc(getRoomRef(state.roomCode), updates);
          return;
        } else {
          updateDoc(getRoomRef(state.roomCode), {
            [`${myField}.solvedCount`]: solvedCount
          }).catch(() => {});
        }
      } else {
        const isT1 = state.localData.currentTurn === 'team1';
        const pct = (solvedCount / totalQ) * 100;
        if (isT1) {
          state.localData.team1Solved = solvedCount;
          document.getElementById('game-t1-count').textContent = `${solvedCount} / ${totalQ}`;
          document.getElementById('game-t1-bar').style.width = `${pct}%`;
        } else {
          state.localData.team2Solved = solvedCount;
          document.getElementById('game-t2-count').textContent = `${solvedCount} / ${totalQ}`;
          document.getElementById('game-t2-bar').style.width = `${pct}%`;
        }
        if (solvedCount === totalQ) {
          state.isRoundActive = false;
          stopRoundTimer();
          const elapsed = Number(((Date.now() - state.roundStartTime) / 1000 + state.penaltySeconds).toFixed(1));
          if (isT1) {
            state.localData.team1Time = elapsed;
            showToast(`أنهى ${state.localData.team1Name} الأسئلة في ${elapsed} ثانية! الآن دور ${state.localData.team2Name}`, 'success');
            setTimeout(() => {
              state.localData.currentTurn = 'team2';
              startRoundSequence(state.localData.activeGroupId);
            }, 1400);
          } else {
            state.localData.team2Time = elapsed;
            renderLocalResults();
          }
          return;
        }
      }

      for (let i = 0; i < totalQ; i++) {
        const nextIdx = (index + 1 + i) % totalQ;
        if (!state.solvedIndices.has(nextIdx)) {
          const nextInput = document.getElementById(`q-input-${nextIdx}`);
          if (nextInput) {
            nextInput.focus();
            nextInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          break;
        }
      }
    }

    // ==========================================
‎    // 11. النتائج والاحتفال
    // ==========================================
    function triggerConfetti() {
      if (typeof confetti === 'function') {
        confetti({ particleCount: 90, spread: 75, origin: { y: 0.6 } });
      }
    }

    function populateAnswersReview() {
      const container = document.getElementById('round-answers-review');
      container.innerHTML = '';
      if (!state.currentGroup) return;
      state.currentGroup.items.forEach((item, idx) => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between py-1.5 px-2.5 rounded-lg bg-slate-800/70';
        div.innerHTML = `
          <span class="text-slate-300 text-xs sm:text-sm">${idx + 1}. ${item.q}</span>
          <span class="font-extrabold text-emerald-400 text-xs sm:text-sm">${item.a[0]}</span>
        `;
        container.appendChild(div);
      });
    }

    function renderOnlineResults(data) {
      playSound('win');
      triggerConfetti();
      const t1 = data.team1 || { name: 'الفريق الأول', solvedCount: 0, finishTime: null };
      const t2 = data.team2 || { name: 'الفريق الثاني', solvedCount: 0, finishTime: null };
      const totalQ = state.currentGroup ? state.currentGroup.items.length : 8;
      const winnerName = data.roundWinner === 'team1' ? t1.name : t2.name;
      document.getElementById('winner-headline').textContent = `🏆 فاز ${winnerName}!`;
      document.getElementById('winner-subtext').textContent = 'أنهى جميع الأسئلة أولاً وحسم نقطة الجولة!';
      document.getElementById('res-t1-name').textContent = t1.name;
      document.getElementById('res-t1-time').textContent = t1.finishTime ? `${t1.finishTime} ث` : 'لم يكتمل';
      document.getElementById('res-t1-solved').textContent = `أجاب على ${t1.solvedCount || 0} من ${totalQ}`;
      document.getElementById('res-t2-name').textContent = t2.name;
      document.getElementById('res-t2-time').textContent = t2.finishTime ? `${t2.finishTime} ث` : 'لم يكتمل';
      document.getElementById('res-t2-solved').textContent = `أجاب على ${t2.solvedCount || 0} من ${totalQ}`;
      populateAnswersReview();
      switchScreen('screen-results');
    }

    function renderLocalResults() {
      playSound('win');
      triggerConfetti();
      const ld = state.localData;
      const totalQ = state.currentGroup.items.length;
      let headline = '';
      if (ld.team1Time < ld.team2Time) {
        ld.team1Score += 1;
        headline = `🏆 فاز ${ld.team1Name}!`;
      } else if (ld.team2Time < ld.team1Time) {
        ld.team2Score += 1;
        headline = `🏆 فاز ${ld.team2Name}!`;
      } else {
        headline = '🤝 تعادل مذهل في نفس الثانية!';
      }
      document.getElementById('winner-headline').textContent = headline;
      document.getElementById('winner-subtext').textContent = `الفارق الزمني: ${Math.abs(ld.team1Time - ld.team2Time).toFixed(1)} ثانية`;
      document.getElementById('res-t1-name').textContent = ld.team1Name;
      document.getElementById('res-t1-time').textContent = `${ld.team1Time} ث`;
      document.getElementById('res-t1-solved').textContent = `أجاب على ${totalQ} من ${totalQ}`;
      document.getElementById('res-t2-name').textContent = ld.team2Name;
      document.getElementById('res-t2-time').textContent = `${ld.team2Time} ث`;
      document.getElementById('res-t2-solved').textContent = `أجاب على ${totalQ} من ${totalQ}`;
      populateAnswersReview();
      switchScreen('screen-results');
    }

    // ==========================================
‎    // 12. ربط الأحداث
    // ==========================================
    document.addEventListener('DOMContentLoaded', async () => {
      await initFirebase();

      const modeOnlineBtn = document.getElementById('mode-online-btn');
      const modeLocalBtn = document.getElementById('mode-local-btn');
      const onlineBox = document.getElementById('online-setup-box');
      const localBox = document.getElementById('local-setup-box');

      modeOnlineBtn.addEventListener('click', () => {
        state.mode = 'online';
        modeOnlineBtn.className = 'mode-selector active flex flex-col items-start p-4 rounded-2xl border-2 border-sky-500 bg-sky-500/10 text-right transition';
        modeLocalBtn.className = 'mode-selector flex flex-col items-start p-4 rounded-2xl border-2 border-slate-700 bg-slate-800/60 hover:border-slate-500 text-right transition';
        onlineBox.classList.remove('hidden');
        localBox.classList.add('hidden');
      });

      modeLocalBtn.addEventListener('click', () => {
        state.mode = 'local';
        modeLocalBtn.className = 'mode-selector active flex flex-col items-start p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-500/10 text-right transition';
        modeOnlineBtn.className = 'mode-selector flex flex-col items-start p-4 rounded-2xl border-2 border-slate-700 bg-slate-800/60 hover:border-slate-500 text-right transition';
        localBox.classList.remove('hidden');
        onlineBox.classList.add('hidden');
      });

      document.getElementById('create-room-btn').addEventListener('click', createOnlineRoom);
      document.getElementById('join-room-btn').addEventListener('click', () => joinOnlineRoom());

      document.getElementById('start-local-btn').addEventListener('click', () => {
        state.mode = 'local';
        state.localData.team1Name = document.getElementById('local-team1-name').value.trim() || 'الفريق الأول';
        state.localData.team2Name = document.getElementById('local-team2-name').value.trim() || 'الفريق الثاني';
        state.localData.team1Score = 0;
        state.localData.team2Score = 0;
        state.localData.usedGroups = [];
        updateLocalLobbyUI();
        switchScreen('screen-lobby');
      });

      function updateLocalLobbyUI() {
        document.getElementById('lobby-t1-name').textContent = state.localData.team1Name;
        document.getElementById('lobby-t1-score').textContent = state.localData.team1Score;
        document.getElementById('lobby-t2-name').textContent = state.localData.team2Name;
        document.getElementById('lobby-t2-score').textContent = state.localData.team2Score;
        document.getElementById('room-share-box').classList.add('hidden');
        document.getElementById('lobby-status-banner').textContent = 'اختر الحرفين: يبدأ الفريق الأول أولاً ثم يتبعه الفريق الثاني لمقارنة الزمن!';
        renderLettersGrid(state.localData.usedGroups, true);
      }

      document.getElementById('copy-link-btn').addEventListener('click', () => {
        const url = new URL(window.location.href);
        if (state.roomCode) url.searchParams.set('room', state.roomCode);
        const shareText = `انضم معي في مسابقة "آخر حرفين"! رمز الغرفة: ${state.roomCode}\n${url.toString()}`;
        const tempInput = document.createElement('textarea');
        tempInput.value = shareText;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        showToast('تم نسخ رابط الدعوة ورمز الغرفة! أرسله للفريق المنافس.', 'success');
      });

      document.getElementById('random-letters-btn').addEventListener('click', () => {
        const used = state.mode === 'online' ? (state.roomData?.usedGroups || []) : state.localData.usedGroups;
        const available = QUIZ_GROUPS.filter(g => !used.includes(g.id));
        const pool = available.length > 0 ? available : QUIZ_GROUPS;
        const randomGroup = pool[Math.floor(Math.random() * pool.length)];
        handleSelectGroup(randomGroup.id);
      });

      document.getElementById('next-round-btn').addEventListener('click', async () => {
        document.getElementById('round-answers-review').classList.add('hidden');
        if (state.mode === 'online') {
          await updateDoc(getRoomRef(state.roomCode), {
            status: 'lobby',
            activeGroupId: null,
            roundWinner: null
          });
        } else {
          updateLocalLobbyUI();
          switchScreen('screen-lobby');
        }
      });

      document.getElementById('toggle-answers-btn').addEventListener('click', () => {
        document.getElementById('round-answers-review').classList.toggle('hidden');
      });

      document.getElementById('sound-toggle-btn').addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        document.getElementById('sound-on-icon').classList.toggle('hidden', !soundEnabled);
        document.getElementById('sound-off-icon').classList.toggle('hidden', soundEnabled);
        showToast(soundEnabled ? 'تم تفعيل المؤثرات الصوتية' : 'تم كتم الصوت');
      });

      document.getElementById('home-btn').addEventListener('click', () => {
        stopRoundTimer();
        if (state.unsubscribeRoom) {
          state.unsubscribeRoom();
          state.unsubscribeRoom = null;
        }
        state.roomCode = null;
        state.roomData = null;
        switchScreen('screen-setup');
      });

      try {
        const params = new URLSearchParams(window.location.search);
        const roomParam = params.get('room');
        if (roomParam) {
          document.getElementById('join-room-code').value = roomParam;
          showToast(`تم اكتشاف رمز الغرفة (${roomParam}) من الرابط! أدخل اسم فريقك واضغط دخول.`, 'info');
        }
      } catch (e) {}
    });
  </script>
</body>
</html>
