    function playSound(type) {
      if (!soundEnabled) return;
      try {
        if (!synth && typeof Tone !== 'undefined') {
          synth = new Tone.PolySynth(Tone.Synth).toDestination();
          synth.volume.value = -8;
        }
        if (!synth) return;
        if (Tone.context.state !== 'running') Tone.start();
        const now = Tone.now();
        if (type === 'correct') synth.triggerAttackRelease(['C5', 'E5', 'G5'], '16n', now);
        else if (type === 'tick') synth.triggerAttackRelease('A4', '32n', now);
        else if (type === 'go') synth.triggerAttackRelease(['C5', 'G5', 'C6'], '8n', now);
        else if (type === 'win') {
          synth.triggerAttackRelease('C5', '16n', now);
          synth.triggerAttackRelease('E5', '16n', now + 0.12);
          synth.triggerAttackRelease('G5', '16n', now + 0.24);
          synth.triggerAttackRelease('C6', '4n', now + 0.36);
        } else if (type === 'hint') synth.triggerAttackRelease('D4', '16n', now);
      } catch (e) {}
    }

