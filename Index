  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Cairo', 'sans-serif'] },
          colors: {
            team1: { light: '#38bdf8', DEFAULT: '#0284c7', dark: '#0369a1' },
            team2: { light: '#fb923c', DEFAULT: '#ea580c', dark: '#c2410c' },
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background: radial-gradient(circle at top right, #0f172a, #020617 75%);
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .glass-panel {
      background: rgba(30, 41, 59, 0.72);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(148, 163, 184, 0.16);
      box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6);
    }
    .letter-card { transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .letter-card:hover:not(:disabled) {
      transform: translateY(-4px) scale(1.03);
      border-color: #38bdf8;
      box-shadow: 0 12px 24px -8px rgba(56, 189, 248, 0.35);
    }
    @keyframes popIn {
      0% { transform: scale(0.85); opacity: 0; }
      70% { transform: scale(1.04); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop { animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
      50% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    }
    .solved-row { animation: pulseGlow 0.8s ease-out; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
  </style>
</head>
<body class="antialiased selection:bg-sky-500 selection:text-white">

  <header class="sticky top-0 z-40 glass-panel border-b border-slate-700/60 px-4 py-3">
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center font-black text-xl shadow-lg shadow-sky-500/20">
          ٢
        </div>
        <div>
          <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-tight">مسابقة آخر حرفين</h1>
          <p id="header-subtitle" class="text-xs text-slate-400">تحدي السرعة والذكاء بين فريقين</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="sound-toggle-btn" title="تفعيل/كتم الصوت" class="p-2.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 transition">
          <svg id="sound-on-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <svg id="sound-off-icon" class="w-5 h-5 hidden text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
        </button>
        <button id="home-btn" class="hidden px-3 py-2 rounded-xl bg-slate-800/90 hover:bg-rose-950/70 hover:text-rose-300 border border-slate-700 text-xs sm:text-sm font-bold text-slate-300 transition">
‎          خروج / القائمة
        </button>
      </div>
    </div>
  </header>

  <div id="toast-container" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-[90%] max-w-md pointer-events-none"></div>

  <main class="max-w-5xl mx-auto px-4 py-6 sm:py-8">

    <section id="screen-setup" class="animate-pop max-w-2xl mx-auto">
      <div class="glass-panel rounded-3xl p-6 sm:p-8">
        <div class="text-center mb-7">
          <span class="inline-block px-3.5 py-1 rounded-full bg-sky-500/15 border border-sky-400/30 text-sky-300 text-xs font-bold mb-3">
‎            ١٦ مجموعة حروف • أكثر من ١٣٠ سؤالاً
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-2">أهلاً بكم في مسابقة آخر حرفين!</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
‎            اختاروا الحرفين اللذين تنتهي بهما جميع الإجابات، وتسابقوا في حل الأسئلة بأسرع وقت ممكن.
          </p>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-slate-300 mb-2.5">اختر طريقة اللعب:</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button type="button" id="mode-online-btn" class="mode-selector active flex flex-col items-start p-4 rounded-2xl border-2 border-sky-500 bg-sky-500/10 text-right transition">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="font-extrabold text-white text-base">🌐 لعب مباشر (جهازين)</span>
                <span class="w-3 h-3 rounded-full bg-sky-400 shadow-sm shadow-sky-400"></span>
              </div>
              <p class="text-xs text-slate-300">أنشئ غرفة وشارك الرابط أو الرمز مع الفريق المنافس لسباق حي في نفس اللحظة.</p>
            </button>
            <button type="button" id="mode-local-btn" class="mode-selector flex flex-col items-start p-4 rounded-2xl border-2 border-slate-700 bg-slate-800/60 hover:border-slate-500 text-right transition">
              <div class="flex items-center justify-between w-full mb-1">
                <span class="font-extrabold text-white text-base">📱 لعب سريع (نفس الجهاز)</span>
                <span class="w-3 h-3 rounded-full bg-slate-600"></span>
              </div>
              <p class="text-xs text-slate-400">يتناوب الفريقان على نفس الجهاز، ويُحسب الزمن الدقيق لكل فريق لتحديد الفائز.</p>
            </button>
          </div>
        </div>

        <div id="online-setup-box" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-700/80 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded-md bg-sky-500/20 text-sky-300 text-xs font-bold">الفريق الأول</span>
                  <h3 class="font-bold text-white text-base">إنشاء غرفة جديدة</h3>
                </div>
                <label class="block text-xs text-slate-400 mb-1">اسم فريقكم:</label>
                <input id="create-team-name" type="text" value="الفريق الأول" maxlength="24" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-600 text-white font-bold focus:outline-none focus:border-sky-400 mb-3" />
              </div>
              <button id="create-room-btn" class="w-full py-3 px-4 rounded-xl bg-gradient-to-l from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-extrabold shadow-lg shadow-sky-600/25 transition active:scale-95">
‎                إنشاء غرفة ومشاركة الرابط
              </button>
            </div>

            <div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-700/80 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded-md bg-orange-500/20 text-orange-300 text-xs font-bold">الفريق الثاني</span>
                  <h3 class="font-bold text-white text-base">الانضمام لغرفة</h3>
                </div>
                <label class="block text-xs text-slate-400 mb-1">اسم فريقكم:</label>
                <input id="join-team-name" type="text" value="الفريق الثاني" maxlength="24" class="w-full px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-600 text-white font-bold focus:outline-none focus:border-orange-400 mb-2" />
                <label class="block text-xs text-slate-400 mb-1">رمز الغرفة (4 أرقام أو أحرف):</label>
                <input id="join-room-code" type="text" placeholder="مثال: 4829" maxlength="6" class="w-full px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-600 text-white font-extrabold tracking-widest text-center uppercase focus:outline-none focus:border-orange-400 mb-3" />
              </div>
              <button id="join-room-btn" class="w-full py-3 px-4 rounded-xl bg-gradient-to-l from-orange-500 to-amber-600 hover:from-orange-400 hover:to-amber-500 text-white font-extrabold shadow-lg shadow-orange-600/25 transition active:scale-95">
‎                دخول الغرفة الآن
              </button>
            </div>
          </div>
        </div>

        <div id="local-setup-box" class="hidden space-y-4">
          <div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-700/80 space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-sky-300 mb-1">اسم الفريق الأول:</label>
                <input id="local-team1-name" type="text" value="الفريق الأول" maxlength="24" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-sky-500/50 text-white font-bold focus:outline-none focus:border-sky-400" />
              </div>
              <div>
                <label class="block text-xs font-bold text-orange-300 mb-1">اسم الفريق الثاني:</label>
                <input id="local-team2-name" type="text" value="الفريق الثاني" maxlength="24" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-orange-500/50 text-white font-bold focus:outline-none focus:border-orange-400" />
              </div>
            </div>
            <button id="start-local-btn" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-l from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-extrabold text-base shadow-lg shadow-emerald-600/25 transition active:scale-95">
‎              ابدأ التحدي المحلي
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="screen-lobby" class="hidden animate-pop space-y-6">
      <div class="glass-panel rounded-3xl p-5 sm:p-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 pb-5 border-b border-slate-700/70">
          <div class="flex items-center justify-center sm:justify-start gap-3 sm:gap-5 w-full md:w-auto">
            <div class="flex-1 sm:flex-initial text-center px-4 py-2.5 rounded-2xl bg-sky-950/60 border border-sky-500/40">
              <div class="text-xs text-sky-300 font-bold mb-0.5">الفريق الأول</div>
              <div id="lobby-t1-name" class="font-extrabold text-white text-sm sm:text-base truncate max-w-[130px]">الفريق الأول</div>
              <div id="lobby-t1-score" class="text-2xl font-black text-sky-400 mt-0.5">0</div>
            </div>
            <div class="text-slate-500 font-black text-lg">VS</div>
            <div class="flex-1 sm:flex-initial text-center px-4 py-2.5 rounded-2xl bg-orange-950/60 border border-orange-500/40">
              <div class="text-xs text-orange-300 font-bold mb-0.5">الفريق الثاني</div>
              <div id="lobby-t2-name" class="font-extrabold text-white text-sm sm:text-base truncate max-w-[130px]">في الانتظار...</div>
              <div id="lobby-t2-score" class="text-2xl font-black text-orange-400 mt-0.5">0</div>
            </div>
          </div>

          <div id="room-share-box" class="w-full md:w-auto flex flex-col sm:flex-row items-center gap-2.5 bg-slate-900/90 p-3 rounded-2xl border border-slate-700">
            <div class="text-center sm:text-right px-2">
              <span class="block text-[11px] text-slate-400">رمز الغرفة للمنافس</span>
              <span id="display-room-code" class="text-xl font-black tracking-widest text-amber-400">----</span>
            </div>
            <button id="copy-link-btn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition active:scale-95">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
‎              نسخ رابط الدعوة
            </button>
          </div>
        </div>

        <div id="lobby-status-banner" class="mt-4 p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-sm font-bold text-center">
‎          شارك رابط الغرفة أو الرمز مع الفريق الثاني، أو اختر الحرفين لبدء التحدي!
        </div>
      </div>

      <div class="glass-panel rounded-3xl p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
          <div>
            <h3 class="text-xl font-extrabold text-white">اختر الحرفين للجولة</h3>
            <p class="text-xs sm:text-sm text-slate-400">جميع إجابات الجولة ستنتهي بالحرفين اللذين تختارهما</p>
          </div>
          <button id="random-letters-btn" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs sm:text-sm font-bold text-sky-300 transition">
‎            🎲 اختيار عشوائي
          </button>
        </div>
        <div id="letters-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4"></div>
      </div>
    </section>

    <section id="screen-countdown" class="hidden fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex flex-col items-center justify-center p-4">
      <div class="text-center animate-pop">
        <p id="countdown-team-label" class="text-lg sm:text-xl font-bold text-sky-300 mb-2">استعدوا للتحدي!</p>
        <div class="inline-block px-6 py-2 rounded-2xl bg-slate-800/90 border border-slate-600 mb-6">
          <span class="text-sm text-slate-400 block">الحرفان المختاران</span>
          <span id="countdown-letters" class="text-3xl sm:text-4xl font-black text-amber-400">- ا ج</span>
        </div>
        <div id="countdown-number" class="text-8xl sm:text-9xl font-black text-white drop-shadow-[0_0_30px_rgba(56,189,248,0.6)]">3</div>
      </div>
    </section>

    <section id="screen-game" class="hidden animate-pop space-y-5">
      <div class="glass-panel rounded-3xl p-4 sm:p-5 sticky top-[68px] z-30 border-slate-600/50">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-3">
            <div class="px-4 py-1.5 rounded-2xl bg-amber-500/20 border border-amber-400/40 text-center">
              <span class="text-[11px] text-amber-200 block font-bold">تنتهي بـ</span>
              <span id="game-active-letters" class="text-xl sm:text-2xl font-black text-amber-400">- ا ج</span>
            </div>
            <div>
              <span id="current-turn-badge" class="inline-block px-2.5 py-0.5 rounded-md bg-sky-500/20 text-sky-300 text-xs font-bold mb-0.5">جاري السباق</span>
              <h3 id="game-prompt-title" class="text-sm sm:text-base font-extrabold text-white">اكتب الإجابة في الخانات بأسرع وقت!</h3>
            </div>
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 px-4 py-2 rounded-2xl border border-slate-700">
            <svg class="w-5 h-5 text-emerald-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="game-timer" class="text-xl sm:text-2xl font-black font-mono text-white">00:00</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div id="p1-progress-card" class="p-3 rounded-2xl bg-slate-900/80 border border-sky-500/40">
            <div class="flex justify-between items-center text-xs font-bold mb-1.5">
              <span id="game-t1-name" class="text-sky-300 truncate max-w-[150px]">الفريق الأول</span>
              <span id="game-t1-count" class="text-white">0 / 8</span>
            </div>
            <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden">
              <div id="game-t1-bar" class="h-full bg-gradient-to-l from-sky-400 to-blue-600 transition-all duration-300 rounded-full" style="width: 0%"></div>
            </div>
          </div>
          <div id="p2-progress-card" class="p-3 rounded-2xl bg-slate-900/80 border border-orange-500/40">
            <div class="flex justify-between items-center text-xs font-bold mb-1.5">
              <span id="game-t2-name" class="text-orange-300 truncate max-w-[150px]">الفريق الثاني</span>
              <span id="game-t2-count" class="text-white">0 / 8</span>
            </div>
            <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden">
              <div id="game-t2-bar" class="h-full bg-gradient-to-l from-orange-400 to-amber-600 transition-all duration-300 rounded-full" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="questions-list" class="space-y-3 pb-10"></div>
    </section>

    <section id="screen-results" class="hidden animate-pop max-w-2xl mx-auto">
      <div class="glass-panel rounded-3xl p-6 sm:p-8 text-center">
        <div class="w-20 h-20 mx-auto mb-4 rounded-3xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-4xl shadow-xl shadow-amber-500/30">🏆</div>
        <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold mb-2">انتهت الجولة!</span>
        <h2 id="winner-headline" class="text-2xl sm:text-4xl font-black text-white mb-2">فاز الفريق الأول!</h2>
        <p id="winner-subtext" class="text-slate-300 text-sm sm:text-base mb-6">أنهى جميع الأسئلة في زمن قياسي!</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 text-right">
          <div id="res-t1-box" class="p-4 rounded-2xl bg-slate-900/80 border-2 border-sky-500/50">
            <div class="flex items-center justify-between mb-1">
              <span id="res-t1-name" class="font-extrabold text-sky-300">الفريق الأول</span>
              <span id="res-t1-badge" class="text-xs px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-bold">النتيجة</span>
            </div>
            <div id="res-t1-time" class="text-2xl font-black text-white font-mono">00:00</div>
            <div id="res-t1-solved" class="text-xs text-slate-400 mt-1">أجاب على 8 من 8</div>
          </div>
          <div id="res-t2-box" class="p-4 rounded-2xl bg-slate-900/80 border-2 border-orange-500/50">
            <div class="flex items-center justify-between mb-1">
              <span id="res-t2-name" class="font-extrabold text-orange-300">الفريق الثاني</span>
              <span id="res-t2-badge" class="text-xs px-2 py-0.5 rounded bg-orange-500/20 text-orange-300 font-bold">النتيجة</span>
            </div>
            <div id="res-t2-time" class="text-2xl font-black text-white font-mono">00:00</div>
            <div id="res-t2-solved" class="text-xs text-slate-400 mt-1">أجاب على 6 من 8</div>
          </div>
        </div>

        <div class="mb-6 text-right">
          <button id="toggle-answers-btn" class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs sm:text-sm font-bold text-slate-200 flex items-center justify-between transition">
            <span>📖 عرض جميع أسئلة وإجابات هذه الجولة</span>
            <span>▼</span>
          </button>
          <div id="round-answers-review" class="hidden mt-3 max-h-60 overflow-y-auto rounded-2xl bg-slate-900/90 border border-slate-700 p-3 space-y-2 text-sm"></div>
