    function normalizeArabic(text) {
      if (!text) return { raw: '', noAl: '' };
      let clean = text.trim()
        .replace(/[\u064B-\u065F\u0670\u0640]/g, '')
        .replace(/[أإآٱ]/g, 'ا')
        .replace(/ؤ/g, 'و')
        .replace(/ئ/g, 'ي')
        .replace(/ة/g, 'ه')
        .replace(/\s+/g, ' ');
      const withoutAl = clean.startsWith('ال') && clean.length > 3 ? clean.slice(2) : clean;
      return { raw: clean, noAl: withoutAl };
    }

    function checkAnswerMatch(userInput, validAnswers) {
      const userNorm = normalizeArabic(userInput);
      if (!userNorm.raw) return false;
      return validAnswers.some(ans => {
        const ansNorm = normalizeArabic(ans);
        return (
          userNorm.raw === ansNorm.raw ||
          userNorm.noAl === ansNorm.noAl ||
          userNorm.raw === ansNorm.noAl ||
          userNorm.noAl === ansNorm.raw
        );
      });
    }

